#!/usr/bin/env bash
set -euo pipefail

active_site="/etc/nginx/sites-enabled/default"
include_statement="    include /etc/nginx/snippets/library-api.conf;"

if ! grep --fixed-strings --quiet "$include_statement" "$active_site"; then
  sed -i "s|^    location / {|$include_statement\n\n    location / {|" "$active_site"
fi

nginx -t
