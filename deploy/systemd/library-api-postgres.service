[Unit]
Description=Library API PostgreSQL
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/library-api/application.env
ExecStartPre=/bin/sh -c '/usr/bin/podman network exists library-api || /usr/bin/podman network create library-api'
ExecStartPre=/usr/bin/mkdir -p /var/lib/library-api/postgres
ExecStartPre=-/usr/bin/podman rm -f library-api-postgres
ExecStart=/bin/sh -c 'exec /usr/bin/podman run --rm --name library-api-postgres --network library-api -v /var/lib/library-api/postgres:/var/lib/postgresql/data:Z -e POSTGRES_DB="$POSTGRES_DB" -e POSTGRES_USER="$DB_USER" -e POSTGRES_PASSWORD="$DB_PASSWORD" docker.io/library/postgres:17-alpine'
ExecStop=/usr/bin/podman stop library-api-postgres
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
